<Window xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="GflChibiDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GflChibiDesktop"
        mc:Ignorable="d"
        Title="关于程序" Width="600" Height="300" AllowsTransparency="True" WindowStyle="None" Background="{x:Null}" Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SnapsToDevicePixels="True" Closed="Window_Closed" Icon="hk416_happy.ico" Loaded="Window_Loaded" hc:WindowAttach.IgnoreAltF4="True" hc:WindowAttach.ShowInTaskManager="False">
    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="20" BorderThickness="2" BorderBrush="Black">
            <Border.Background>
                <ImageBrush ImageSource="background-tile-purple.png" TileMode="Tile" Viewport="0,0,0.05,0.1" Opacity="0.8"/>
            </Border.Background>
            <Canvas Width="600" Height="300" >
                <Border MouseMove="Border_MouseMove" VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="20,20,0,0" BorderThickness="1" Height="50" Width="598" Canvas.Left="-1" Canvas.Top="-1" Cursor="SizeAll" BorderBrush="Black">
                    <Border.Background>
                        <ImageBrush ImageSource="background-tile-yellow.png" TileMode="Tile" Viewport="0,0,0.04,0.6" Opacity="0.8"/>
                    </Border.Background>
                    <Canvas>
                        <Image RenderTransformOrigin="0,0" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Canvas.Left="6" Canvas.Top="6" Height="36" Width="36" HorizontalAlignment="Left" Source="hk416_happy.ico"/>
                        <Label x:Name="lbl_product" Content="ProductName" Canvas.Left="47" Canvas.Top="6" Width="480" Height="36" FontSize="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" Foreground="Black" />
                        <Button x:Name="btnClose" BorderBrush="{x:Null}" Foreground="White" Focusable="False" IsTabStop="False" Style="{StaticResource ButtonDanger}" hc:BorderElement.CornerRadius="0,20,0,0" hc:IconElement.Geometry="{StaticResource RemoveGeometry}" Click="btn_Close_Click" BorderThickness="0" Cursor="Arrow" Width="64" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Height="48" Canvas.Left="532">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource DangerColor}" Opacity="0.6"/>
                            </Button.Background>
                        </Button>
                    </Canvas>
                </Border>
                <Border VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="5" BorderThickness="2" BorderBrush="Black" Height="167" Width="420" Canvas.Left="10" Canvas.Top="60">
                    <Border.Background>
                        <SolidColorBrush Color="#FF38E0FF" Opacity="0.8"/>
                    </Border.Background>
                    <Canvas>
                        <Label Content="程序版本信息" Canvas.Left="10" Canvas.Top="5" Width="396" Height="27" FontSize="16" VerticalContentAlignment="Center" Background="{x:Null}" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" Padding="0" Foreground="Black" />
                        <Label x:Name="lbl_version" Content="当前版本：Version 构建 BuildDate Build"  Canvas.Left="10" Canvas.Top="32" Width="396" Height="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" Foreground="Black" />
                        <Label x:Name="lbl_latest_version" Content="线上版本：Version 构建 BuildDate Build" Canvas.Left="10" Canvas.Top="48" Width="396" Height="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" Foreground="Black" />
                        <Label x:Name="lbl_status" Content="版本状态" Canvas.Left="10" Canvas.Top="64" Width="396" Height="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" Foreground="Black" FontWeight="Bold" />
                        <hc:TextBox x:Name="txt_description" Canvas.Left="10" Canvas.Top="80" Width="396" Height="48" Padding="0" Background="{x:Null}" IsReadOnly="True" Text="版本更新内容信息" Foreground="Black" VerticalContentAlignment="Top" HorizontalContentAlignment="Center" VerticalScrollBarVisibility="Auto" BorderThickness="0" TextWrapping="Wrap" BorderBrush="{x:Null}"/>
                        <Label Canvas.Left="10" Canvas.Top="128" Width="396" Height="32" Background="{x:Null}" VerticalContentAlignment="Stretch" UseLayoutRounding="False" HorizontalContentAlignment="Stretch" BorderBrush="{x:Null}" Padding="0" >
                            <TextBlock x:Name="tb_extraStr" TextWrapping="Wrap" Text="额外文本" TextAlignment="Center" Foreground="Black" FontWeight="Bold" />
                        </Label>
                    </Canvas>
                </Border>
                <Image x:Name="imgEmote" RenderTransformOrigin="0,0" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Canvas.Left="435" Canvas.Top="60" Height="135" Width="150" MouseLeftButtonDown="imgEmote_MouseLeftButtonDown" Cursor="UpArrow"/>
                <Label Content="此程序仅供个人学习研究与交流用，严禁用于商业用途。&#xD;&#xA;作者不对因使用此程序而产生的各种后果承担任何责任。" Canvas.Left="10" Canvas.Top="232" Width="420" Height="33" VerticalContentAlignment="Top" Background="{x:Null}" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" Padding="0" Foreground="Black" VerticalAlignment="Center" />
                <Label x:Name="lblCopyright" Content="© 2020~2022 BrightSu" Canvas.Left="10" Canvas.Top="266" Width="420" Height="19" VerticalContentAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" Foreground="Black" />
                <Button x:Name="btn_Actions" Content="前往主页" Height="40" Width="150" Canvas.Left="435" Canvas.Top="200" Click="btn_Actions_Click" BorderThickness="2" Padding="0" Foreground="Black" FontSize="18" >
                    <Button.Background>
                        <ImageBrush ImageSource="background-tile-yellow.png" TileMode="Tile" Viewport="0,0,0.2,0.75"/>
                    </Button.Background>
                </Button>
                <Button x:Name="btn_Close" Content="确定" Height="40" Width="150" Canvas.Left="435" Canvas.Top="245" Click="btn_Close_Click" BorderThickness="2" IsCancel="True" IsDefault="True" Padding="0" Foreground="Black" FontSize="18" >
                    <Button.Background>
                        <ImageBrush ImageSource="background-tile-yellow.png" TileMode="Tile" Viewport="0,0,0.2,0.75"/>
                    </Button.Background>
                </Button>
            </Canvas>
        </Border>
    </Grid>
</Window>
