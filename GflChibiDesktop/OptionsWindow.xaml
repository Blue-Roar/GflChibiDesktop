<Window xmlns:hc="https://handyorg.github.io/handycontrol"  x:Class="GflChibiDesktop.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GflChibiDesktop"
        mc:Ignorable="d"
        Title="选项" Width="250" Height="320" AllowsTransparency="True" WindowStyle="None" ScrollViewer.VerticalScrollBarVisibility="Disabled" ResizeMode="NoResize" Topmost="True" Icon="hk416_happy.ico" Closing="Window_Closing" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Visibility="Visible" Loaded="Window_Loaded" Background="{x:Null}" hc:WindowAttach.IgnoreAltF4="True" hc:WindowAttach.ShowInTaskManager="False" >
    <Grid Name="GridAttributes" >
        <Border BorderThickness="1" BorderBrush="#FF333337" CornerRadius="5,5,5,5">
            <Border.Background>
                <SolidColorBrush Color="#FF202020" Opacity="0.5"/>
            </Border.Background>
        </Border>
        <Border x:Name="titleBar" MouseMove="Border_MouseMove" Cursor="SizeAll" Height="25" VerticalAlignment="Top" Margin="1,1,1,0">
            <Grid>
                <Label Content="战术人形控制台" Background="{x:Null}" VerticalContentAlignment="Center" BorderBrush="{x:Null}" Padding="6,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Button x:Name="btnClose" BorderBrush="{x:Null}" Foreground="White" Focusable="False" IsTabStop="False" Style="{StaticResource ButtonDanger}" hc:BorderElement.CornerRadius="0,5,0,0" hc:IconElement.Geometry="{StaticResource RemoveGeometry}" Click="btnClose_Click" BorderThickness="0" Cursor="Arrow" Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Height="25">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource DangerColor}" Opacity="0.6"/>
                    </Button.Background>
                </Button>
            </Grid>
            <Border.Background>
                <SolidColorBrush Color="Black" Opacity="0.3"/>
            </Border.Background>
        </Border>
        <Grid x:Name="grid" VerticalAlignment="Top" Width="240" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
            </Grid.RowDefinitions>
            <!--操作-->
            <Label Content="操作" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <Button Name="btnLoad" Content="加载" Grid.Column="1" VerticalAlignment="Stretch" Height="22" Margin="0" Grid.ColumnSpan="1" HorizontalContentAlignment="Center" Click="btnLoad_Click" Padding="0" HorizontalAlignment="Stretch"/>
            <!--置顶-->
            <Label Content="置于顶层" Grid.Column="2" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="chb_TopMost" Grid.Column="3"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="True" Click="chb_TopMost_Click" Margin="0" Padding="0"  />
            <!--名称-->
            <Label Name="lbl_Dummy" Content="未加载" Grid.Row="1" Background="{x:Null}" Grid.ColumnSpan="4" VerticalContentAlignment="Center" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            <!--皮肤-->
            <!--<Label Content="皮肤" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Background="{x:Null}" />
                <ComboBox Name="cb_SkinList" Grid.Row="3" Grid.Column="1"  HorizontalAlignment="Left"  MinWidth="100" VerticalAlignment="Center" Width="Auto" SelectionChanged="cb_SkinList_SelectionChanged"/>-->
            <!--动画-->
            <Label Content="动画" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <ComboBox Name="cb_AnimeList" Grid.Row="2" Grid.Column="1"  SelectionChanged="cb_AnimeList_SelectionChanged" Margin="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" MinHeight="24" VerticalAlignment="Center" Height="24" Padding="0" SelectedIndex="0"/>
            <!-- FPS -->
            <Label Content="FPS" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <!--<TextBox Name="tb_Fps" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" MinWidth="30"  TextWrapping="NoWrap" Text=string.Empty VerticalAlignment="Center"  Width="Auto"  MaxLength="3" />-->
            <Slider Name="sld_Fps" Grid.Column="1" Grid.Row="3" Background="{x:Null}" BorderBrush="{x:Null}" Maximum="60" SmallChange="1" TickFrequency="5" LargeChange="5" Minimum="1" Value="30" AutoToolTipPlacement="TopLeft" Margin="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" VerticalAlignment="Center" IsSelectionRangeEnabled="True" SelectionStart="30" SelectionEnd="60" TickPlacement="BottomRight"/>
            <!-- 循环播放 -->
            <Label Content="循环播放" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}"  BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" IsEnabled="{Binding IsEnabled, ElementName=chb_IsLoop}"/>
            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="chb_IsLoop" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"  VerticalAlignment="Center" IsChecked="True" Click="chb_IsLoop_Click" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" Padding="0"/>
            <!-- 动态模拟 -->
            <Label Content="动态模拟" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="chb_Simulate" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="chb_Simulate_Click" Padding="0" />
            <!-- 模拟间隔 -->
            <Label Content="模拟间隔" Grid.Row="5" Grid.Column="0"  HorizontalAlignment="Stretch" Background="{x:Null}" IsEnabled="{Binding IsChecked, ElementName=chb_Simulate}"  BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch"/>
            <!--<TextBox Name="tb_Spine_Scale" Grid.Row="9" Grid.Column="1"   HorizontalAlignment="Left" MinWidth="30" VerticalAlignment="Center"/>-->
            <Slider Name="sld_Simulation_Interval" Grid.Column="1" Grid.Row="5" Background="{x:Null}" BorderBrush="{x:Null}" Maximum="120" SmallChange="5" LargeChange="10" AutoToolTipPlacement="TopLeft" Value="30" Minimum="10" Margin="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=chb_Simulate}" ValueChanged="sld_Simulation_Interval_ValueChanged" VerticalAlignment="Center" IsSelectionRangeEnabled="True" SelectionStart="30" SelectionEnd="90" TickPlacement="BottomRight" TickFrequency="10"/>
            <!-- 缩放倍率 -->
            <Label Content="缩放倍率" Grid.Row="6" Grid.Column="0"  HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <!--<TextBox Name="tb_Spine_Scale" Grid.Row="9" Grid.Column="1"   HorizontalAlignment="Left" MinWidth="30" VerticalAlignment="Center"/>-->
            <Slider Name="sld_Spine_Scale" Grid.Column="1" Grid.Row="6" Background="{x:Null}" BorderBrush="{x:Null}" Maximum="2" SmallChange="0.01" TickFrequency="0.1" LargeChange="0.1" AutoToolTipPlacement="TopLeft" Value="1" Minimum="0.01" Margin="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutoToolTipPrecision="2" VerticalAlignment="Center" IsSelectionRangeEnabled="True" SelectionStart="0.75" SelectionEnd="1.25" TickPlacement="BottomRight"/>
            <!--透明度-->
            <Label Content="透明度" Grid.Row="7" Grid.Column="0"  HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <Slider x:Name="sld_Opacity" Grid.Column="1" Grid.Row="7" Background="{x:Null}" BorderBrush="{x:Null}" Maximum="1" SmallChange="0.01" LargeChange="0.1" AutoToolTipPlacement="TopLeft" Value="1" Margin="0" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutoToolTipPrecision="2" VerticalAlignment="Center" TickFrequency="0.05" IsDirectionReversed="True" IsSelectionRangeEnabled="True" SelectionStart="0.8" SelectionEnd="1" TickPlacement="BottomRight"/>

            <!--透明-->
            <!--
            <Label Content="背景透明" Grid.Row="7" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <CheckBox Name="chb_Alpha" Grid.Row="7" Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="True" VerticalContentAlignment="Center" Margin="0" HorizontalContentAlignment="Center" Padding="0"  />
            -->
            <!--预乘透明-->
            <!--
            <Label Content="预乘透明" Grid.Row="7" Grid.Column="2" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <CheckBox Name="chb_PreMultiplyAlpha" Grid.Row="7" Grid.Column="3"  HorizontalAlignment="Left"  VerticalAlignment="Center" IsChecked="True" Click="chb_PreMultiplyAlpha_Click" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" />-->
            <!--水平坐标-->
            <Label Content="水平位置" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <!--<TextBox Name="tb_PosX"  Grid.Row="8" Grid.Column="1"  Text=string.Empty Margin="0,4,9,4" VerticalAlignment="Center" VerticalContentAlignment="Center"/>-->
            <hc:NumericUpDown Name="tb_PosX" Grid.Row="8" Grid.Column="1" Padding="2,0,0,0" MinHeight="24" Height="24" />
            <!--垂直坐标-->
            <Label Content="垂直位置" Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <!--<TextBox Name="tb_PosY" Grid.Row="8" Grid.Column="3" Text=string.Empty  VerticalAlignment="Center" Margin="0,4,9,4" VerticalContentAlignment="Center"/>-->
            <hc:NumericUpDown Name="tb_PosY" Grid.Row="8" Grid.Column="3" Padding="2,0,0,0" MinHeight="24" Height="24" />
            <!--水平翻转-->
            <Label Content="水平翻转" Grid.Row="9" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="chb_FilpX" Grid.Row="9" Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" IsEnabled="{Binding IsChecked, Converter={StaticResource InverseBooleanConverter}, ElementName=chb_Simulate}" Padding="0" />
            <!--垂直翻转-->
            <Label Content="垂直翻转" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Name="chb_FilpY" Grid.Row="9" Grid.Column="3"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" Padding="0" />
            <!--旋转-->
            <Label Content="旋转角度" Grid.Row="10" Grid.Column="0" HorizontalAlignment="Stretch" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" />
            <!--<TextBox Name="tb_Rotation"  Grid.Row="14" Grid.Column="1"  Text=string.Empty HorizontalAlignment="Left"  VerticalAlignment="Center" Width="60"/>-->
            <Slider Name="sld_Rotation" Grid.Column="1" Grid.Row="10" Background="{x:Null}" BorderBrush="{x:Null}" Maximum="359" SmallChange="1" TickFrequency="5" LargeChange="5" AutoToolTipPlacement="TopLeft" Grid.ColumnSpan="3" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
